endFill=0;startFill=0;" edge="1" parent="1" source="r3" target="r37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e178" value="memiliki" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;" edge="1" parent="1" source="r3" target="r53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e179" value="disewakan" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;" edge="1" parent="1" source="r50" target="r113"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e180" value="disewa" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;" edge="1" parent="1" source="r85" target="r110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e181" value="bertipe" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;" edge="1" parent="1" source="r78" target="r88"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e182" value="diperpanjang" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;" edge="1" parent="1" source="r107" target="r156"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n183" value="&lt;b&gt;Catatan&lt;/b&gt;&lt;br&gt;• Nominal uang dalam rupiah (integer).&lt;br&gt;• rent_price_total = biaya sewa + biaya isi listrik (akumulatif).&lt;br&gt;• Biaya listrik = kapasitas (kW) × (100 − sisa %) / 100 × tarif per kWh.&lt;br&gt;• Satu garasi hanya untuk satu kendaraan per hari; transaksi declined tidak menahan garasi.&lt;br&gt;• Tabel bawaan Laravel (sessions, password_reset_tokens, cache, jobs) tidak digambarkan." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="560" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
